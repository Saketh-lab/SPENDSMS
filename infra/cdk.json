{
  "app": "npx ts-node --prefer-ts-exts bin/spendsms.ts",
  "watch": {
    "include": ["**"],
    "exclude": ["README.md", "cdk.out", "node_modules", "test"]
  },
  "context": {
    "@aws-cdk/core:bootstrapQualifier": "spendsms",
    "@aws-cdk/aws-s3:serverAccessLogsUseBucketPolicy": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/aws-cloudfront:defaultSecurityPolicyTLSv1.2_2021": true,
    "@aws-cdk/aws-cloudfront-origins:wildcardKeyPolicyForOac": true
  }
}
