    <string name="deletion_title">Delete analysed data</string>
    <string name="deletion_body">This permanently deletes local transactions, corrections, subscriptions, scan progress, and dashboard cache from this device.\n\nParser rule packages bundled with the app are retained so scanning can work offline.\n\nRaw SMS in your inbox is never modified.</string>
