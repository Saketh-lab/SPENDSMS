<full-backup-content>
    <!-- Phase-0: no unsecured backup of financial records, prefs, or Keystore-wrapped keys. -->
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
